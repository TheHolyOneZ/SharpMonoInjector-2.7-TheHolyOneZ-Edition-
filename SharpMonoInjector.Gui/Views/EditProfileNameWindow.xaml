<Window x:Class="SharpMonoInjector.Gui.Views.EditProfileNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Profile Name" Height="240" Width="450"
        WindowStyle="None" ResizeMode="CanResize" Background="#FF1A1A1A" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=NewNameTextBox}">
    <Border BorderBrush="#FF00E676" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Modern Title Bar -->
            <Border Grid.Row="0" Background="#FF000000" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="✏️" FontSize="18" VerticalAlignment="Center" Foreground="#FF00E676" Margin="0,0,10,0"/>
                        <TextBlock Text="Edit Profile Name" Foreground="#FF00E676" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Width="40" Height="40" Background="Transparent" Foreground="#FFFFFFFF"
                            BorderThickness="0" FontSize="16" Click="Close_Click" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFF4444"/>
                                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile Name Input -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Profile Name:" FontSize="14" FontWeight="SemiBold" Foreground="#FF00E676" Margin="0,0,0,8"/>
                    <TextBox x:Name="NewNameTextBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             FontSize="16" Padding="10,8" Background="#FF252525" Foreground="#FFFFFFFF"
                             BorderBrush="#FF3A3A3A" BorderThickness="1" Margin="0,0,0,0"
                             ToolTip="Enter a new descriptive name for this injection profile"
                             IsEnabled="True" Focusable="True" IsReadOnly="False"/>
                </Grid>

                <!-- Help Text -->
                <TextBlock Grid.Row="1" Text="💡 Profile names help you quickly identify different injection configurations"
                           Foreground="#FF666666" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top"/>
            </Grid>

            <!-- Modern Footer -->
            <Border Grid.Row="2" Background="#FF1E1E1E" CornerRadius="0,0,12,12">
                <Grid Margin="25,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ValidationMessage}" Foreground="#FFFF6B6B" FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,15,0"
                            IsCancel="True" Click="Cancel_Click" Height="35"/>
                    <Button Grid.Column="2" Content="💾 Save Name" Style="{StaticResource ModernButton}" Width="110"
                            IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="35" FontSize="13"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>